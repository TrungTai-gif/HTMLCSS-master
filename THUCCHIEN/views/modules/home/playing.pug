.playing
    +home-right-title("Currently Playing",true)
    .playing-main  
        img.playing-img(src="../images/avatar.png", alt="avatar")
        span.playing-title Don't Always Win | LifeSpring
        span.playing-name  Episode 1 - Yahia Amin 
        .playing-time
            time 1:30
            .playing-item-img
                img(src="../images/icons/suara.svg", alt="suara")
            time 5:59
        .playing-bottom 
            .playing-play 
                img(src="../images/icons/repeate.svg", alt="repeate")
                .playing-play-main 
                    img(src="../images/icons/previous.svg", alt="previous")
                    img(src="../images/icons/pause.svg", alt="pause")
                    img(src="../images/icons/next.svg", alt="next")
                img(src="../images/icons/shuffle.svg", alt="shuffle")
            .playing-volume 
                img(src="../images/icons/volume.svg", alt="volume")